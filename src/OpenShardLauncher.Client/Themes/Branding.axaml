<!-- The launcher's colors, brushes and fonts. Forks restyle the launcher here (and replace the art in Assets/). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="DisplayFont">Cinzel, Trajan Pro, Georgia, Times New Roman, serif</FontFamily>

  <LinearGradientBrush x:Key="GoldBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#FFF6D9" />
    <GradientStop Offset="0.45" Color="#D9A953" />
    <GradientStop Offset="0.55" Color="#9C6B2A" />
    <GradientStop Offset="1" Color="#E8C379" />
  </LinearGradientBrush>

  <!-- Window -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141110" />
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A2E1F" />

  <!-- Title and subtitle -->
  <SolidColorBrush x:Key="TitleBrush" Color="#F3D58A" />
  <Color x:Key="TitleGlowColor">#FF8A2A</Color>
  <SolidColorBrush x:Key="SubtitleBrush" Color="#D9C9A3" />

  <!-- Text over the art -->
  <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#D9C9A3" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B5E" />

  <!-- Notices that can't be dismissed (the unsigned-feed strip): amber with dark text -->
  <SolidColorBrush x:Key="WarningBrush" Color="#D9922A" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#1A1208" />

  <!-- Navigation links -->
  <SolidColorBrush x:Key="NavBrush" Color="#E3CF9E" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#FFF4D2" />

  <!-- Play button -->
  <SolidColorBrush x:Key="PlayTextBrush" Color="#F2E6CC" />
  <SolidColorBrush x:Key="PlayGlowBrush" Color="#FF7A1F" />

  <!-- Progress bars -->
  <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#1A1512" />

  <!-- Settings, minimize, close and cancel squares -->
  <SolidColorBrush x:Key="ChromeGlyphBrush" Color="#E8D6B0" />
  <SolidColorBrush x:Key="ChromeBorderBrush" Color="#6B5431" />
  <SolidColorBrush x:Key="ChromeSettingsBrush" Color="#1E2A44" />
  <SolidColorBrush x:Key="ChromeSettingsHoverBrush" Color="#2E3F63" />
  <SolidColorBrush x:Key="ChromeMinimizeBrush" Color="#3E3A24" />
  <SolidColorBrush x:Key="ChromeMinimizeHoverBrush" Color="#5C5634" />
  <SolidColorBrush x:Key="ChromeCloseBrush" Color="#5A1717" />
  <SolidColorBrush x:Key="ChromeCloseHoverBrush" Color="#8A2020" />

  <!-- Text buttons (Retry, Show and dialog buttons) -->
  <SolidColorBrush x:Key="ButtonTextBrush" Color="#F2E6CC" />
  <SolidColorBrush x:Key="ButtonBrush" Color="#3A120D" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#6A2216" />
  <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#241C16" />
  <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#3A2E22" />
</ResourceDictionary>
