<!-- Control styles for the launcher window and its dialogs. Colors and fonts come from Branding.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OpenShardLauncher.Client.Views">

  <!-- Settings, minimize, close and cancel squares -->
  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeGlyphBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="2"
                CornerRadius="2" BoxShadow="inset 0 0 8 0 #80000000">
          <ContentPresenter Name="Glyph" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.chrome.settings">
    <Setter Property="Background" Value="{DynamicResource ChromeSettingsBrush}" />
  </Style>
  <Style Selector="Button.chrome.settings:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChromeSettingsHoverBrush}" />
  </Style>
  <Style Selector="Button.chrome.minimize">
    <Setter Property="Background" Value="{DynamicResource ChromeMinimizeBrush}" />
  </Style>
  <Style Selector="Button.chrome.minimize:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChromeMinimizeHoverBrush}" />
  </Style>
  <Style Selector="Button.chrome.close">
    <Setter Property="Background" Value="{DynamicResource ChromeCloseBrush}" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChromeCloseHoverBrush}" />
  </Style>

  <!-- Text buttons: Retry, Show and the buttons along the bottom of dialogs -->
  <Style Selector="Button.dialog">
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GoldBrush}"
                BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.dialog:pointerover">
    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
  </Style>
  <Style Selector="Button.dialog.secondary">
    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
  </Style>
  <Style Selector="Button.dialog.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}" />
  </Style>
  <!-- The small Retry and Show buttons beside the status lines -->
  <Style Selector="Button.dialog.small">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Top navigation links: brighten and grow a gold underline from the center on hover -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NavBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" Spacing="4">
          <ContentPresenter Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" />
          <Border Name="Underline" Height="2" CornerRadius="1" Background="{DynamicResource GoldBrush}"
                  RenderTransform="scaleX(0)">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NavHoverBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ Border#Underline">
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>
  <!-- Verify while a check or download is running -->
  <Style Selector="Button.nav:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Play button: Assets/play-button.png (270x96) that glows and grows slightly on hover.
       The glow is the image's shape filled with orange and blurred, so it follows any art -->
  <Style Selector="Button.play">
    <Setter Property="Foreground" Value="{DynamicResource PlayTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Width="270" Height="96">
          <Border Name="Glow" Margin="-6" Opacity="0" Background="{DynamicResource PlayGlowBrush}">
            <Border.OpacityMask>
              <ImageBrush Source="{x:Static views:LauncherArt.PlayButton}" Stretch="Fill" />
            </Border.OpacityMask>
            <Border.Effect>
              <BlurEffect Radius="18" />
            </Border.Effect>
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Image Source="{x:Static views:LauncherArt.PlayButton}" Stretch="Fill" />
          <!-- Shrinks longer labels (e.g. the download text) to fit inside the frame -->
          <Viewbox StretchDirection="DownOnly" Margin="34,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" OffsetX="0" OffsetY="2" Opacity="0.9" />
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Viewbox>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.play:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ Border#Glow">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.play:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.play:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Progress bars: the fill image is stretched to the full bar width and revealed from the left as progress grows.
       Assets/progress-total.png (all files) and Assets/progress-file.png (current file), 508x22 -->
  <Style Selector="ProgressBar.bar">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Background" Value="{DynamicResource ProgressBarBackgroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Border Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
            <Image Name="Fill" Stretch="Fill" HorizontalAlignment="Left"
                   Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ProgressBar.total /template/ Image#Fill">
    <Setter Property="Source" Value="{x:Static views:LauncherArt.ProgressTotal}" />
  </Style>
  <Style Selector="ProgressBar.file /template/ Image#Fill">
    <Setter Property="Source" Value="{x:Static views:LauncherArt.ProgressFile}" />
  </Style>
  <Style Selector="TextBlock.barText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="16,0" />
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="1" />
    </Setter>
  </Style>

  <!-- Dialogs: a gold-framed panel over the dimmed launcher -->
  <Style Selector="Border.dialogFrame">
    <Setter Property="Width" Value="460" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource DialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #C0000000" />
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DialogTitleBrush}" />
  </Style>
  <Style Selector="TextBlock.dialogText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
  </Style>
  <Style Selector="TextBlock.dialogLabel">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
  </Style>
  <Style Selector="TextBlock.dialogHint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource DialogMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.dialogError">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.dialogFrame CheckBox">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Border.dialogFrame TextBox">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.dialog:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Status and notice lines over the art -->
  <Style Selector="TextBlock.overArt">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="1" />
    </Setter>
  </Style>
</Styles>
